{
  "name": "Lead Qualification Orchestration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-qualification",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1f3c6b1a-0d84-4e71-9c87-8dd3cce5a001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/leads/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Idempotency-Key",
              "value": "={{$json.body.idempotencyKey || $execution.id}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{JSON.stringify($json.body)}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "1f3c6b1a-0d84-4e71-9c87-8dd3cce5a002",
      "name": "Submit Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "id": "1f3c6b1a-0d84-4e71-9c87-8dd3cce5a003",
      "name": "Wait For Qualification",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [740, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_BASE_URL}}/api/leads/{{$node['Submit Lead'].json.leadId}}/qualification",
        "options": {
          "timeout": 30000
        }
      },
      "id": "1f3c6b1a-0d84-4e71-9c87-8dd3cce5a004",
      "name": "Get Qualification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "qualification-ready",
              "leftValue": "={{$json.aiProcessed}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1f3c6b1a-0d84-4e71-9c87-8dd3cce5a005",
      "name": "Qualification Ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "high-priority",
              "leftValue": "={{$json.priority}}",
              "rightValue": "HIGH",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1f3c6b1a-0d84-4e71-9c87-8dd3cce5a006",
      "name": "Priority HIGH?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1460, 220]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "={{$env.N8N_HIGH_PRIORITY_SLACK_CHANNEL}}",
        "text": "=High-priority lead: {{$json.aiSummary || 'Qualification complete'}}\nReason: {{$json.aiReason || 'Not provided'}}\nLead ID: {{$json.id}}",
        "otherOptions": {}
      },
      "id": "1f3c6b1a-0d84-4e71-9c87-8dd3cce5a007",
      "name": "Notify HIGH in Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1700, 120],
      "credentials": {
        "slackApi": {
          "id": "__N8N_CREDENTIAL_ID__",
          "name": "Slack Lead Notifications"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{JSON.stringify({ok: true, leadId: $json.id, priority: $json.priority, qualification: $json})}}",
        "options": {}
      },
      "id": "1f3c6b1a-0d84-4e71-9c87-8dd3cce5a008",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1940, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{JSON.stringify({ok: false, error: 'Lead qualification orchestration failed', details: $json.error || $json.message || 'Unknown error'})}}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "1f3c6b1a-0d84-4e71-9c87-8dd3cce5a009",
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1460, 520]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Submit Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit Lead": {
      "main": [
        [
          {
            "node": "Wait For Qualification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait For Qualification": {
      "main": [
        [
          {
            "node": "Get Qualification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Qualification": {
      "main": [
        [
          {
            "node": "Qualification Ready",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Qualification Ready": {
      "main": [
        [
          {
            "node": "Priority HIGH?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait For Qualification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Priority HIGH?": {
      "main": [
        [
          {
            "node": "Notify HIGH in Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify HIGH in Slack": {
      "main": [
        [
          {
            "node": "Success Response",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
